---
import "../styles/global.css";
import { Font } from "astro:assets";
import CookieConsent from "../components/CookieConsent.astro";
import { INDEXABLE, GSC_VERIFICATION } from "../data/company";
import { t, LANGS, HOME_ROUTES, type Lang } from "../i18n";
import { url } from "../lib/url";
import { jsonLd } from "../lib/schema";

interface Props {
  lang: Lang;
  /** titlul si descrierea paginii; pe home raman cele din dictionar */
  title?: string;
  description?: string;
  /** aceeasi pagina in fiecare limba, fara base (pentru canonical si hreflang) */
  paths?: Record<Lang, string>;
  /** noduri JSON-LD pentru pagina curenta */
  schema?: Record<string, unknown>[];
  /** pagini care nu trebuie indexate nici in productie (ex. 404) */
  noindex?: boolean;
}

const { lang, title, description, paths = HOME_ROUTES, schema = [], noindex = false } = Astro.props;
const d = t(lang);
const siteUrl = Astro.site ?? new URL("https://horelink.ro");
const abs = (path: string) => new URL(url(path), siteUrl).href;
const pageTitle = title ?? d.meta.title;
const pageDescription = description ?? d.meta.description;
const canonical = abs(paths[lang]);
const ogImage = abs(`/og/horelink-${lang}.jpg`);
---

<!doctype html>
<html lang={d.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/png" href={url("/favicon.png")} />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <meta name="theme-color" content="#0a0a0b" />
    {/* doar productia (horelink.ro) se indexeaza; demo-ul de pe GitHub Pages ramane noindex */}
    <meta
      name="robots"
      content={INDEXABLE && !noindex ? "index, follow, max-image-preview:large, max-snippet:-1" : "noindex, nofollow"}
    />
    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}

    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(paths[l])} />)}
    <link rel="alternate" hreflang="x-default" href={abs(paths.ro)} />

    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-inter" preload />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HoreLink" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={lang === "ro" ? "ro_RO" : "en_GB"} />
    <meta property="og:locale:alternate" content={lang === "ro" ? "en_GB" : "ro_RO"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    {schema.length > 0 && <script type="application/ld+json" set:html={jsonLd(schema)} />}
  </head>
  <body>
    <a
      href="#continut"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-ink focus:text-white focus:px-4 focus:py-2 focus:rounded-btn"
    >
      {d.a11y.skip}
    </a>
    <slot />
    <CookieConsent lang={lang} />

    <script>
      // Entrance discret pe sectiuni. Fara IntersectionObserver ar aparea totul deodata.
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const targets = document.querySelectorAll<HTMLElement>(".reveal");

      if (reduce) {
        targets.forEach((el) => el.classList.add("is-in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-in");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.08 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
