---
/**
 * Corpul paginii, identic pentru ambele limbi. Cele doua rute
 * (/ si /en/) doar ii dau limba.
 */
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import CumFunctioneaza from "./CumFunctioneaza.astro";
import PentruPersonal from "./PentruPersonal.astro";
import PentruAngajatori from "./PentruAngajatori.astro";
import Evenimente from "./Evenimente.astro";
import Anunt from "./Anunt.astro";
import Descarca from "./Descarca.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import type { Lang } from "../i18n";
import { schemaHelpers } from "../lib/schema";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const schema = schemaHelpers(Astro.site ?? new URL("https://horelink.ro")).homeGraph(lang);
---

<Layout lang={lang} schema={schema}>
  <Header lang={lang} />
  <main id="continut">
    <Hero lang={lang} />
    <CumFunctioneaza lang={lang} />
    <PentruPersonal lang={lang} />
    <PentruAngajatori lang={lang} />
    <Evenimente lang={lang} />
    <Anunt lang={lang} />
    <Descarca lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
