---
import { t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
// Structura de mai jos e exact cea a unui anunt din aplicatie:
// locatie, start, final, zile de lucru, pozitii cu numar de locuri.
const d = t(lang).anunt;
---

<section class="anunt on-dark">
  <div class="wrap grid">
    <div class="card-col reveal">
      <article class="card" aria-label={d.cardAria}>
        <header>
          <h3>{d.cardTitle}</h3>
          <p>{d.cardDesc}</p>
        </header>

        <dl>
          {
            d.campuri.map((c) => (
              <div class="rand">
                <dt>{c.eticheta}</dt>
                <dd>{c.valoare}</dd>
              </div>
            ))
          }
        </dl>

        <div class="pozitii">
          <h4>{d.pozitiiTitle}</h4>
          <ul>
            {
              d.pozitii.map((p) => (
                <li>
                  <span class="nume">{p.nume}</span>
                  <span class="locuri">{p.locuri}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    </div>

    <div class="copy reveal">
      <h2>{d.titlePre}<span class="accent">{d.titleAccent}</span></h2>
      <p class="lede">{d.lede}</p>

      <ul class="note">
        {
          d.note.map((n) => (
            <li>
              <h3>{n.titlu}</h3>
              <p>{n.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .anunt {
    background: var(--color-ink);
    color: #fff;
    padding-block: clamp(4rem, 2.5rem + 6vw, 7.5rem);
  }

  .grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 4.5rem;
    }
  }

  /* --- cardul de anunt, in limbajul vizual al aplicatiei --- */
  .card {
    background: #fdfcfb;
    color: var(--color-graphite);
    border-radius: 14px;
    padding: 1.6rem 1.5rem;
    max-width: 27rem;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.28),
      0 18px 40px -18px rgba(0, 0, 0, 0.6);
  }

  .card header h3 {
    font-size: 1.28rem;
  }

  .card header p {
    margin-block-start: 0.5rem;
    color: var(--color-slate);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .card dl {
    margin: 1.4rem 0 0;
    display: grid;
    gap: 2px;
  }

  .rand {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.72rem;
    border-block-start: 1px solid var(--color-paper-2);
  }

  .rand dt {
    color: var(--color-slate);
    font-size: 0.86rem;
  }

  .rand dd {
    margin: 0;
    font-weight: 600;
    font-size: 0.94rem;
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  .pozitii {
    margin-block-start: 1.4rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--color-paper-2);
  }

  .pozitii h4 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.94rem;
    letter-spacing: -0.01em;
    margin-block-end: 0.7rem;
  }

  .pozitii ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .pozitii li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    background: var(--color-paper);
    border-radius: 8px;
    padding: 0.62rem 0.8rem;
  }

  .pozitii .nume {
    font-weight: 600;
    font-size: 0.93rem;
  }

  .pozitii .locuri {
    font-size: 0.83rem;
    color: var(--color-brand);
    font-variant-numeric: tabular-nums;
  }

  /* --- explicatiile --- */
  .lede {
    margin-block: 1.25rem 2.25rem;
    font-size: 1.06rem;
    color: rgba(255, 255, 255, 0.78);
    max-width: 34rem;
  }

  .note {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.6rem;
  }

  @media (min-width: 620px) {
    .note {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.9rem 2.25rem;
    }
  }

  .note li {
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--color-brand);
  }

  .note h3 {
    font-size: 1.02rem;
  }

  .note p {
    margin-block-start: 0.4rem;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.95rem;
    line-height: 1.58;
  }

  .card-col {
    display: flex;
    justify-content: center;
  }
</style>
