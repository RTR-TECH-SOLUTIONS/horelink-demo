---
import StoreBadges from "./StoreBadges.astro";
import { t, type Lang } from "../i18n";
import { url } from "../lib/url";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang).descarca;
---

<section class="section descarca" id="descarca">
  <div class="wrap inner reveal">
    <div class="icon-tile" aria-hidden="true">
      <img src={url("/app/mark-160.png")} alt="" width="128" height="128" loading="lazy" />
    </div>

    <h2>{d.title}</h2>
    <p>{d.text}</p>

    <StoreBadges lang={lang} size="lg" class="center" />
  </div>
</section>

<style>
  .descarca {
    background: var(--color-paper);
    border-block-start: 1px solid var(--color-paper-2);
  }

  .inner {
    max-width: 38rem;
    margin-inline: auto;
    text-align: center;
  }

  .icon-tile {
    width: 76px;
    height: 76px;
    margin-inline: auto;
    margin-block-end: 1.75rem;
    display: grid;
    place-items: center;
    background: var(--color-ink);
    border-radius: 18px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.16),
      0 14px 30px -14px rgba(0, 0, 0, 0.35);
  }

  .icon-tile img {
    width: 54px;
    height: 54px;
  }

  .inner p {
    margin-block: 1.1rem 2.25rem;
    color: var(--color-slate);
    font-size: 1.06rem;
  }

  .inner :global(.store-badges.center) {
    justify-content: center;
  }
</style>
