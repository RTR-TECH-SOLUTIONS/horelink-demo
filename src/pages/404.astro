---
/**
 * Pagina 404. O singura pagina pentru ambele limbi (serverul o serveste pentru orice
 * adresa gresita), deci textul principal e in romana, cu o linie in engleza.
 */
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { base } from "../i18n";
---

<Layout lang="ro" title="Pagina nu există | HoreLink" description="Adresa accesată nu există pe horelink.ro." noindex>
  <Header lang="ro" solid />
  <main id="continut" class="not-found">
    <div class="wrap">
      <p class="code">404</p>
      <h1>Pagina asta nu există.</h1>
      <p class="lede">
        Poate a fost mutată sau adresa are o greșeală. De pe pagina principală ajungi la tot ce e pe site.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={base("ro")}>Pagina principală</a>
        <a class="btn btn-ghost-light" href={base("en")} lang="en" hreflang="en">English version</a>
      </div>
    </div>
  </main>
  <Footer lang="ro" />
</Layout>

<style>
  .not-found {
    min-height: 70vh;
    padding-block: calc(var(--header-h) + clamp(3rem, 2rem + 5vw, 6rem)) clamp(4rem, 3rem + 5vw, 7rem);
  }

  .code {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-brand);
  }

  h1 {
    margin-block: 0.5rem 1rem;
  }

  .lede {
    max-width: 36rem;
    color: var(--color-slate);
    font-size: 1.08rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 2rem;
  }
</style>
